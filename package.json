{
    "name": "@nsat/react-lazylog",
    "version": "5.0.0",
    "description": "React Lazy Logviewer (Spire)",
    "license": "MPL-2.0",
    "repository": "nsat/react-lazylog",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./dist/index.css": "./dist/index.css",
        "./styles.css": "./dist/index.css"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/"
    },
    "files": [
        "dist",
        "src/lib"
    ],
    "keywords": [
        "react",
        "log",
        "viewer",
        "logviewer",
        "lazy",
        "lazylog"
    ],
    "scripts": {
        "build": "tsc --noEmit && vite build",
        "build:lib": "tsc --noEmit && vite build",
        "build:demo": "vite build --mode demo",
        "dev": "vite",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.58.12",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.5",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "jsdom": "^30.0.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.7.0",
        "vite": "^8.2.1",
        "vite-plugin-dts": "^5.0.3",
        "vite-plugin-singlefile": "^2.3.3",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "hotkeys-js": "^4.0.5",
        "immutable": "^5.1.9",
        "mitt": "^3.0.1",
        "react-string-replace": "^2.0.1",
        "react-virtualized-auto-sizer": "^2.0.3",
        "react-window": "^2.3.0"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    }
}
